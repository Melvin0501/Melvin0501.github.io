---
// "My Model UN story": a long page with its own table of contents and an interactive city map.
// Content lives in src/data/mun.ts.
import Base from '../../../layouts/Base.astro';
import { languages, langParam, toLang, href, asset, ui } from '../../../i18n';
import {
  munPage, toc, motivation, domesticIntro, delegatingIntro, chairingIntro, hostingIntro,
  delegating, chairing, hosting, internationalIntro, cities, stops, chapterPhotos,
} from '../../../data/mun';

export function getStaticPaths() {
  return languages.map((l) => ({ params: { lang: langParam(l) } }));
}

const lang = toLang(Astro.params.lang);
const showTodo = import.meta.env.DEV;
const cityOf = (id: string) => cities.find((c) => c.id === id)!;

// Great-circle distance from Taipei, in km.
const taipei = cities[0];
const rad = (d: number) => (d * Math.PI) / 180;
const km = (c: { lat: number; lon: number }) => {
  const dLat = rad(c.lat - taipei.lat);
  const dLon = rad(c.lon - taipei.lon);
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(rad(taipei.lat)) * Math.cos(rad(c.lat)) * Math.sin(dLon / 2) ** 2;
  return Math.round((6371 * 2 * Math.asin(Math.sqrt(a))) / 10) * 10;
};
const fmt = (n: number) => n.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US');

// Map: Southeast/East Asia drawn to scale on the left, Lima placed across a break on the right.
const W = 720, H = 300;
const pos = (c: { lon: number; lat: number }) => {
  if (c.lon < 0) return { x: 650, y: 250 };
  const x = 40 + ((c.lon - 96) / (127 - 96)) * 430;
  const y = 30 + ((28 - c.lat) / (28 + 10)) * 230;
  return { x, y };
};
const leg = (fromId: string, toId: string) => {
  const a = pos(cityOf(fromId)), b = pos(cityOf(toId));
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
  const lift = Math.max(28, Math.hypot(b.x - a.x, b.y - a.y) * 0.3);
  return `M${a.x.toFixed(1)},${a.y.toFixed(1)} Q${mx.toFixed(1)},${(my - lift).toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`;
};
---

<Base lang={lang} path="model-un/" title={munPage.title[lang]} description={munPage.lead[lang]}>
  <article class="mun">
    <a class="crumb" href={href(lang, 'work/debate-public-speaking/')}>← {toc.back[lang]}</a>

    <header class="mun-head">
      <div class="page-kicker">{ui.interestsSection[lang]}</div>
      <h1 class="page-title">{munPage.title[lang]}</h1>
      <p class="lead">{munPage.lead[lang]}</p>
    </header>
    <dl class="mun-stats">
      {munPage.stats.map((s) => (
        <div><dt>{s.n}</dt><dd>{s.label[lang]}</dd></div>
      ))}
    </dl>

    <div class="mun-layout">
      <nav class="mun-toc" aria-label={toc.contents[lang]}>
        <p class="mun-toc-label">{toc.contents[lang]}</p>
        <ol>
          <li><a href="#motivation" data-spy="motivation"><span>01</span>{toc.motivation[lang]}</a></li>
          <li>
            <a href="#domestic" data-spy="domestic"><span>02</span>{toc.domestic[lang]}</a>
            <ol>
              <li><a href="#delegating" data-spy="delegating">{toc.delegating[lang]}</a></li>
              <li><a href="#chairing" data-spy="chairing">{toc.chairing[lang]}</a></li>
              <li><a href="#hosting" data-spy="hosting">{toc.hosting[lang]}</a></li>
            </ol>
          </li>
          <li><a href="#international" data-spy="international"><span>03</span>{toc.international[lang]}</a></li>
        </ol>
      </nav>

      <div class="mun-body">
        <section id="motivation" class="mun-chapter">
          <h2><span class="mun-num">01</span>{toc.motivation[lang]}</h2>
          {motivation.map((p, i) => <p class:list={{ 'mun-drop': i === 0 }}>{p[lang]}</p>)}
          <div class="atlas-photos">{chapterPhotos.motivation.map((ph) => (<figure><img src={asset(ph.src)} alt={ph.caption[lang]} loading="lazy" /><figcaption>{ph.caption[lang]}</figcaption></figure>))}</div>
        </section>

        <section id="domestic" class="mun-chapter">
          <h2><span class="mun-num">02</span>{toc.domestic[lang]}</h2>
          <p>{domesticIntro[lang]}</p>

          <section id="delegating" class="mun-sub">
            <div class="mun-sub-head">
              <h3>{toc.delegating[lang]}</h3>
              <button type="button" class="mun-filter" data-filter aria-pressed="false" hidden>
                {toc.awardsOnly[lang]}
              </button>
            </div>
            <p>{delegatingIntro[lang]}</p>
            <div class="atlas-photos">{chapterPhotos.delegating.map((ph) => (<figure><img src={asset(ph.src)} alt={ph.caption[lang]} loading="lazy" /><figcaption>{ph.caption[lang]}</figcaption></figure>))}</div>
            <ul class="record" data-record>
              {delegating.map((r) => (
                <li data-award={r.award ? 'yes' : 'no'}>
                  <span class="record-year">{r.year}</span>
                  <span class="record-main">
                    <strong>{r.conf}</strong>
                    <span class="record-sub">{r.committee} · {r.as}</span>
                  </span>
                  {r.award && <span class:list={['tag', { win: r.award.en === 'Best Delegate' }]}>{r.award[lang]}</span>}
                </li>
              ))}
            </ul>
          </section>

          <section id="chairing" class="mun-sub">
            <h3>{toc.chairing[lang]}</h3>
            <p>{chairingIntro[lang]}</p>
            <div class="atlas-photos">{chapterPhotos.chairing.map((ph) => (<figure><img src={asset(ph.src)} alt={ph.caption[lang]} loading="lazy" /><figcaption>{ph.caption[lang]}</figcaption></figure>))}</div>
            <ul class="record">
              {chairing.map((r) => (
                <li>
                  <span class="record-year">{r.year}</span>
                  <span class="record-main">
                    <strong>{r.conf}</strong>
                    <span class="record-sub">{r.committee}</span>
                  </span>
                  <span class:list={['tag', { win: r.head }]}>{r.role}</span>
                </li>
              ))}
            </ul>
          </section>

          <section id="hosting" class="mun-sub">
            <h3>{toc.hosting[lang]}</h3>
            <p>{hostingIntro[lang]}</p>
            <div class="atlas-photos">{chapterPhotos.hosting.map((ph) => (<figure><img src={asset(ph.src)} alt={ph.caption[lang]} loading="lazy" /><figcaption>{ph.caption[lang]}</figcaption></figure>))}</div>
            <ul class="record">
              {hosting.map((h) => (
                <li>
                  <span class="record-year">{h.year}</span>
                  <span class="record-main">
                    {h.href ? <a href={href(lang, h.href)}><strong>{h.conf}</strong> →</a> : <strong>{h.conf}</strong>}
                    {h.note && <span class="record-sub">{h.note[lang]}</span>}
                  </span>
                  <span class="tag">{h.role[lang]}</span>
                </li>
              ))}
            </ul>
          </section>
        </section>

        <section id="international" class="mun-chapter">
          <h2><span class="mun-num">03</span>{toc.international[lang]}</h2>
          <p>{internationalIntro[lang]}</p>

          <div class="atlas" data-atlas>
            <svg class="atlas-map" viewBox={`0 0 ${W} ${H}`} role="group" aria-label={toc.international[lang]}>
              <line x1="545" y1="20" x2="545" y2={H - 20} class="atlas-break" />
              <text x="560" y={H - 24} class="atlas-note">Pacific</text>
              {stops.slice(1).map((st, i) => <path d={leg(stops[i].city, st.city)} class="atlas-arc" data-arc={st.id} />)}
              {cities.map((c) => {
                const p = pos(c);
                const left = c.id === 'bangkok' || c.id === 'kuala-lumpur' || c.id === 'jakarta';
                return (
                  <g class="atlas-city" data-city={c.id} tabindex="0" role="button" aria-label={c.name[lang]}>
                    <circle cx={p.x} cy={p.y} r="14" class="atlas-halo" />
                    <circle cx={p.x} cy={p.y} r="5" class="atlas-dot" />
                    <text x={left ? p.x - 12 : p.x + 12} y={p.y + 4} text-anchor={left ? 'end' : 'start'} class="atlas-label">{c.name[lang]}</text>
                  </g>
                );
              })}
            </svg>

            <ol class="atlas-tabs" role="tablist" hidden>
              {stops.map((st, i) => (
                <li>
                  <button type="button" role="tab" data-tab={st.id} data-tab-city={st.city} aria-selected="false">
                    <span class="atlas-step">{String(i + 1).padStart(2, '0')}</span>
                    {cityOf(st.city).name[lang]}
                    <small>{st.date[lang]}</small>
                  </button>
                </li>
              ))}
            </ol>

            <div class="atlas-cards">
              {stops.map((st) => {
                const c = cityOf(st.city);
                return (
                  <article class="atlas-card" data-card={st.id} data-card-city={st.city}>
                    <p class="atlas-where">
                      {c.name[lang]}, {c.country[lang]}
                      {c.id !== 'taipei' && <span> · {fmt(km(c))} {toc.kmFromTaipei[lang]}</span>}
                    </p>
                    <h3>{st.conference}</h3>
                    <p class="atlas-meta">
                      {[st.date[lang], st.role?.[lang]].filter(Boolean).join(' · ')}
                      {st.award && <span class="tag win">{st.award[lang]}</span>}
                    </p>
                    {st.text && <p>{st.text[lang]}</p>}
                    {st.photos && (
                      <div class="atlas-photos">
                        {st.photos.map((ph) => (
                          <figure>
                            <img src={asset(ph.src)} alt={ph.caption[lang]} loading="lazy" />
                            <figcaption>{ph.caption[lang]}</figcaption>
                          </figure>
                        ))}
                      </div>
                    )}
                    {st.href && <p class="sub-link"><a href={href(lang, st.href)}>{toc.readMore[lang]} →</a></p>}
                    {showTodo && st.todo && <div class="todo"><strong>{ui.toFill[lang]}</strong>{st.todo}</div>}
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      </div>
    </div>
  </article>

  <script is:inline>
    (function () {
      // Awards-only filter for the delegate record.
      var btn = document.querySelector('[data-filter]');
      var rec = document.querySelector('[data-record]');
      if (btn && rec) {
        btn.hidden = false;
        btn.addEventListener('click', function () {
          var on = btn.getAttribute('aria-pressed') !== 'true';
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          rec.classList.toggle('awards-only', on);
        });
      }

      // City picker: the map dots and the tabs both choose which card is shown.
      var atlas = document.querySelector('[data-atlas]');
      if (atlas) {
        atlas.classList.add('is-interactive');
        atlas.querySelector('.atlas-tabs').hidden = false;
        var pick = function (id) {
          var city = null;
          atlas.querySelectorAll('[data-card]').forEach(function (el) { el.hidden = el.dataset.card !== id; if (el.dataset.card === id) city = el.dataset.cardCity; });
          atlas.querySelectorAll('[data-tab]').forEach(function (el) { el.setAttribute('aria-selected', el.dataset.tab === id ? 'true' : 'false'); });
          atlas.querySelectorAll('[data-city]').forEach(function (el) { el.classList.toggle('is-on', el.dataset.city === city); });
          atlas.querySelectorAll('[data-arc]').forEach(function (el) { el.classList.toggle('is-on', el.dataset.arc === id); });
        };
        atlas.querySelectorAll('[data-tab]').forEach(function (el) { el.addEventListener('click', function () { pick(el.dataset.tab); }); });
        var byCity = function (cityId) {
          var tabs = atlas.querySelectorAll('[data-tab-city="' + cityId + '"]');
          if (!tabs.length) return;
          // Clicking a city again cycles through its stops (Taipei has two).
          var cur = atlas.querySelector('[data-tab][aria-selected="true"]');
          var list = Array.prototype.slice.call(tabs);
          var i = list.indexOf(cur);
          pick(list[(i + 1) % list.length].dataset.tab);
        };
        atlas.querySelectorAll('[data-city]').forEach(function (el) {
          el.addEventListener('click', function () { byCity(el.dataset.city); });
          el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); byCity(el.dataset.city); } });
        });
        var first = atlas.querySelector('[data-tab]');
        if (first) pick(first.dataset.tab);
      }

      // Highlight the part of the page being read in the table of contents.
      var links = document.querySelectorAll('[data-spy]');
      var ids = ['motivation', 'domestic', 'delegating', 'chairing', 'hosting', 'international'];
      var secs = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean);
      var update = function () {
        var line = window.innerHeight * 0.3, cur = null;
        secs.forEach(function (s) { if (s.getBoundingClientRect().top <= line) cur = s.id; });
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) cur = 'international';
        var parent = { delegating: 'domestic', chairing: 'domestic', hosting: 'domestic' }[cur];
        links.forEach(function (a) {
          var on = a.dataset.spy === cur || a.dataset.spy === parent;
          a.classList.toggle('is-current', on);
        });
      };
      window.addEventListener('scroll', function () { requestAnimationFrame(update); }, { passive: true });
      update();
    })();
  </script>
</Base>
